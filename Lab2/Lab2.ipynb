    "A = 0.3\n",
    "f0 = 1000\n",
    "fs = 44100\n",
    "phi = np.pi/2\n",
    "t = np.arange(0, .1, 1.0/fs)\n",
    "x = A * np.exp(1j*(2*f0*np.pi*t + phi))\n",
    "\n",
    "# Codi per representar només la part real\n",
    "plot_signals([np.real(x)], fs, name=['real part'])"
   ]
